# Gnani API key (server-side only — never exposed to the browser).
# Get it from the Gnani console: https://console.gnani.ai
GNANI_API_KEY=your-gnani-api-key

# Gemini API key for English translation + clinical summary (server-side only).
# Get it from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# PORT=8787
# MAX_SESSIONS_PER_IP=2
# GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
